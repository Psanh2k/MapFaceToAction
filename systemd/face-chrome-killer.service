[Unit]
Description=Face Chrome Killer - Terminate Chrome on face match
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Workspace/Project/MapFaceToAction
EnvironmentFile=%h/Workspace/Project/MapFaceToAction/.env
ExecStart=%h/Workspace/Project/MapFaceToAction/.venv/bin/python %h/Workspace/Project/MapFaceToAction/main.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=default.target
