[Unit]
Description=Face Chrome Killer - webcam monitor (minimize/kill Chrome)
After=graphical-session.target pipewire.service
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Workspace/Project/MapFaceToAction
EnvironmentFile=%h/Workspace/Project/MapFaceToAction/.env
ExecStart=%h/Workspace/Project/MapFaceToAction/.venv/bin/python %h/Workspace/Project/MapFaceToAction/main.py
Restart=always
RestartSec=5
StartLimitInterval=300
StartLimitBurst=5

[Install]
WantedBy=graphical-session.target
