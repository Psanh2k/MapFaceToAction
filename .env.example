TRIGGER_COOLDOWN_SECONDS=30

LOG_LEVEL=INFO
DRY_RUN=true

FACE_ENCODING_PATH=data/face_encoding.pkl
REGISTRATION_SAMPLE_COUNT=15
REGISTRATION_MIN_SAMPLES=10
