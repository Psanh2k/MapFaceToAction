CAMERA_INDEX=0

CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_RETRY_DELAY_SECONDS=5

FACE_MATCH_THRESHOLD=0.50
REQUIRED_MATCH_SECONDS=2
REQUIRE_SINGLE_FACE=true

RECOGNITION_INTERVAL_MS=300

CHROME_PROCESS_NAMES=google-chrome,chrome,chromium,chromium-browser
