CAMERA_INDEX=0

CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_RETRY_DELAY_SECONDS=5

FACE_MATCH_THRESHOLD=0.55
REQUIRED_MATCH_SECONDS=1
REQUIRE_SINGLE_FACE=true

RECOGNITION_INTERVAL_MS=100
MATCH_RESET_GRACE_MS=400

CHROME_PROCESS_NAMES=google-chrome,chrome,chromium,chromium-browser
CHROME_TERMINATE_TIMEOUT=5
CHROME_KILL_SCOPE=main_only

TRIGGER_COOLDOWN_SECONDS=30
REQUIRE_FACE_ABSENCE_BEFORE_RETRIGGER=true
FACE_ABSENCE_SECONDS=3

LOG_LEVEL=INFO
DRY_RUN=true

FACE_ENCODING_PATH=data/face_encoding.pkl
REGISTRATION_SAMPLE_COUNT=15
REGISTRATION_MIN_SAMPLES=10
